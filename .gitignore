# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/flagcel_eval.wasm

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env
.env.authentik

# Editor/IDE
# .idea/
# .vscode/

# sqlc generated code
internal/store/postgres/sqlcgen/

# air hot reload
tmp/

# web (SvelteKit)
web/node_modules/
web/.svelte-kit/
web/build/*
!web/build/.gitkeep

# SDK package builds
sdks/js/node_modules/
sdks/js/dist/
__pycache__/
.pytest_cache/
sdks/python/build/
sdks/python/*.egg-info/
sdks/python/.venv/
